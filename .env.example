# Copy this file to .env.local and fill in real values there.
# Never put real keys in this file — it is committed to GitHub.

# Supabase (auth + database). The anon key is designed to be public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API for coaching feedback. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# AssemblyAI for transcription (word timestamps). Server-side only — never prefix with NEXT_PUBLIC_.
ASSEMBLYAI_API_KEY=
