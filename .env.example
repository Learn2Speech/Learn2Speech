# Copy this file to .env.local and fill in real values there.
# Never put real keys in this file — it is committed to GitHub.

# Supabase (auth + database). The anon key is designed to be public; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API for coaching feedback. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# AssemblyAI for transcription (word timestamps). Server-side only — never prefix with NEXT_PUBLIC_.
ASSEMBLYAI_API_KEY=

# Supabase secret key (Project Settings -> API Keys). Server-side only, never NEXT_PUBLIC_. Needed so only the server can change recording status and results.
SUPABASE_SERVICE_ROLE_KEY=

# Which sign-in buttons to show: "google", "apple" or "google,apple". Leave empty until the provider is switched on in Supabase.
NEXT_PUBLIC_OAUTH_PROVIDERS=
